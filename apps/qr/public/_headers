# Security headers for qr.ifn.community (static files: the app shell and its
# assets). Netlify does not apply this file to function responses, so
# netlify/functions/qr-redirect.ts and _lib/http.ts set their own.
#
# CONTENT-SECURITY-POLICY, ENFORCING. What each source is for:
#   script-src  'self' is the Vite bundle. accounts.google.com/gsi/client is
#               Google Sign-In, loaded only when someone signs in to make a
#               trackable link. index.html has no inline script.
#   style-src   fonts.googleapis.com serves the Inter stylesheet linked from
#               index.html; accounts.google.com/gsi/style is the sign-in
#               button's stylesheet. 'unsafe-inline' is needed because the
#               Google Sign-In client injects an inline <style> element.
#   font-src    fonts.gstatic.com serves the Inter font files.
#   img-src     data: is the uploaded logo (read with FileReader) and the PNG
#               and JPEG renders; blob: is qr-code-styling's download and the
#               bulk ZIP. The sign-in button's own images load inside Google's
#               iframe and are governed by Google's policy, not this one.
#   connect-src 'self' is /api/*. data: lets qr-code-styling re-read the
#               uploaded logo when it embeds it in an SVG.
#               accounts.google.com/gsi/ is Google Sign-In's status check.
#   frame-src   the Google Sign-In button renders in an iframe.
#
# Verified in headless Chrome against the built app with zero CSP violations
# on /, the generator with an uploaded logo and each of PNG, SVG and JPEG,
# /bulk including the ZIP, /manage/<token>, and the Google sign-in panel. A
# stricter run without 'unsafe-inline' and without data: in connect-src showed
# both are really needed (Google Sign-In injects a <style>; the logo embed
# fetches a data: URL). Re-run that check before tightening anything here.
#
# HSTS matches ifn.community's (includeSubDomains, no preload; see the root
# public/_headers for why preload is left off).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' data: https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=()
