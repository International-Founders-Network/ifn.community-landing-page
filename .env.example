# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
#
# UNSET IS A SUPPORTED STATE AND IS THE RIGHT ONE LOCALLY. src/lib/analytics.ts
# is completely inert without this: no script is injected, no globals are
# touched, the consent banner does not render, and every tracking call is a
# no-op. That keeps `npm run dev` and Netlify deploy previews out of the
# production property without anyone having to remember to switch anything off.
#
# Set it in the Netlify UI (Site configuration -> Environment variables) scoped
# to the PRODUCTION context only, not to deploy previews or branch deploys.
VITE_GA4_MEASUREMENT_ID=

# Google Identity client ID for the /admin dashboard sign-in.
VITE_GOOGLE_CLIENT_ID=
