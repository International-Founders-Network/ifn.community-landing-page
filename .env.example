# Copy to `.env` and fill in. `.env` is gitignored — keep it that way.
#
# NOTHING IN THIS FILE IS A REAL VALUE. `.env` itself was tracked in git until
# 2026-08-27 and carried a live Neon connection string in the history; that
# credential should be treated as disclosed and rotated.

# Neon Postgres. Use a DEVELOPMENT branch, never the production string.
NETLIFY_DATABASE_URL="postgres://user:pass@host/db"

# Membership subscription billing.
# Use TEST-mode values locally: a live secret key here charges real cards.
STRIPE_SECRET_KEY="sk_test_..."

# NOTE: there is deliberately no price id here. Prices are resolved by Stripe
# LOOKUP KEY at request time (see the PLANS table in netlify/functions/checkout.ts),
# so the same code works in test and live mode and adding a product needs no new
# variable. Set the lookup key on the price in Stripe, in BOTH modes.

# Printed by `stripe listen --forward-to localhost:8888/api/stripe-webhook`.
# The deployed endpoint has a DIFFERENT signing secret; do not reuse this one.
STRIPE_WEBHOOK_SECRET="whsec_..."

# Admin dashboard (existing).
ADMIN_SESSION_SECRET=""
ADMIN_ALLOWED_EMAILS=""

# Member center (/members). SEPARATE FROM THE ADMIN SESSION ABOVE, on purpose:
# the admin cookie's verification path ends in an allowlist check, and a member
# is not an operator. See netlify/functions/_lib/memberSession.ts.
# Any long random string; rotating it signs out every member and nobody else.
MEMBER_SESSION_SECRET=""

# Preview-only sign-in door for /api/member-auth-stub, which mints a member
# session for ANY email. Netlify's CONTEXT already enables it on dev, deploy
# previews and branch deploys, so this only ever needs setting to force it on.
# NEVER SET THIS TO "true" ON PRODUCTION: it is a complete authentication
# bypass. It and the endpoint are deleted when real sign-in lands.
ALLOW_MEMBER_STUB_AUTH=""

# Where the gated member PDFs live. NOTHING IS WIRED YET (open question 3 in
# MEMBER-CENTER-IA.md), so /api/member-download returns 503 until both are set
# AND the signing code exists. The files must not live under dist/ or public/:
# a gated PDF at a public path is one shared link away from being ungated.
MEMBER_PDF_BUCKET=""
MEMBER_PDF_SIGNING_SECRET=""
