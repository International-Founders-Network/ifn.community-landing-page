# Cache policy.
#
# Every asset on the live site was served `cache-control: public,max-age=0,
# must-revalidate` — Netlify's default when nothing says otherwise. That means a
# returning visitor revalidated all ~450 kB of JS and CSS on every navigation,
# including files whose names contain a content hash and therefore can never
# change without the name changing too.
#
# THIS FILE COULD NOT SAFELY EXIST UNTIL THE SOFT-404 WAS FIXED, and the order
# of those two changes is the whole reason this comment is here. While the
# catch-all in netlify.toml returned `status = 200`, a request for a hashed
# chunk that no longer existed — say a tab left open across a deploy asking for
# /assets/Home-OLDHASH.js — was answered with the HTML shell and a 200. Marking
# that response `immutable` would have pinned an HTML document at a .js URL for
# a year, and `immutable` means the browser does not revalidate even on a hard
# reload. That route would have been permanently broken in that browser with no
# recovery short of clearing site data. The catch-all now returns 404, so a
# missing chunk is a miss rather than a poisoned cache entry.

# ---------------------------------------------------------------------------
# SECURITY HEADERS
#
# The live site sent exactly one of these — HSTS, and only its weakest form.
# There was no X-Content-Type-Options, no Referrer-Policy, no framing policy and
# no Permissions-Policy. None of these affect ranking directly; they are here
# because a public site that collects names, email addresses and payment intent
# should not be missing the free ones.
#
# Netlify merges every matching block, so these apply alongside the cache rules
# below rather than replacing them.
# ---------------------------------------------------------------------------
/*
  # Stops a browser from second-guessing a declared Content-Type. Without it, a
  # file served as text/plain that happens to look like script can be executed
  # as script.
  X-Content-Type-Options: nosniff

  # Send the full URL to ourselves, only the origin to third parties, and
  # nothing at all when leaving HTTPS. Without this, the full path of the page
  # someone came from leaks to every outbound link — including from /admin.
  Referrer-Policy: strict-origin-when-cross-origin

  # No one has any reason to frame this site. Blocks clickjacking outright.
  # (frame-ancestors 'none' is the modern equivalent and arrives with the CSP below.)
  X-Frame-Options: DENY

  # Drop capabilities the site never uses, so a future dependency cannot quietly
  # start asking for them.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=()

  # HSTS, upgraded. The live value was `max-age=31536000` alone.
  #
  # `includeSubDomains` was verified as safe before being added rather than
  # assumed: the only subdomains that resolve are qr.ifn.community and
  # www.ifn.community, and both already serve HTTPS with HSTS of their own. A
  # subdomain served over plain HTTP would have been made unreachable by this.
  #
  # `preload` is deliberately NOT set. It is close to irreversible — removal
  # from the browser preload list takes months to propagate — and it should be a
  # conscious decision rather than something inherited from a config file. Add
  # it, and submit at hstspreload.org, only when you are certain every current
  # and future subdomain will always be HTTPS.
  Strict-Transport-Security: max-age=63072000; includeSubDomains

# A CONTENT SECURITY POLICY IS THE ONE STILL MISSING, AND IT IS LEFT OFF ON
# PURPOSE RATHER THAN OVERLOOKED.
#
# A wrong CSP breaks the site silently for real visitors while looking fine in
# every check you would think to run, so it should be added deliberately, tested
# against a deploy preview with the browser console open, and not before.
# Everything needed to do that is here.
#
# index.html carries one inline classic script — the theme bootstrap that
# prevents a flash of the wrong palette — and it cannot become an external file
# without reintroducing that flash. So the policy needs its hash, computed from
# the BUILT output (dist/index.html), not the source:
#
#   'sha256-esW/1UYzIMAdg6XSltigJroAJf2yve8LXzbhmFGrnsI='
#
# Recompute it whenever that script changes, or the site loads unstyled:
#
#   python3 -c "import re,hashlib,base64;h=open('dist/index.html').read();\
#   s=re.findall(r'<script(?![^>]*src=)(?![^>]*ld\+json)[^>]*>(.*?)</script>',h,re.S)[0];\
#   print('sha256-'+base64.b64encode(hashlib.sha256(s.encode()).digest()).decode())"
#
# A starting policy, once GA4 is live. Test it on a deploy preview first:
#
#   Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-esW/1UYzIMAdg6XSltigJroAJf2yve8LXzbhmFGrnsI=' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://images.lumacdn.com https://*.google-analytics.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://accounts.google.com; frame-src https://accounts.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
#
# Three things that policy has to account for, all of which are easy to miss:
#   - `style-src 'unsafe-inline'`: framer-motion writes inline styles on every
#     animated element. Removing it stops every animation on the site.
#   - `images.lumacdn.com`: event cover images come from Luma, not from here.
#   - `accounts.google.com`: the /admin sign-in. Omit it and admin login breaks,
#     which no visitor will ever report to you.
#
# Deploy it first as Content-Security-Policy-Report-Only, watch the console on
# every route including /admin and /gallery, then switch to enforcing.

# Content-hashed build output. The hash IS the cache key: a changed file gets a
# changed name, so this can be cached for a year and never revalidated.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts. Stable filenames, but these change roughly never, and a
# font swap on a repeat visit is a visible reflow. A year, revalidated.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Photographs. Content-addressed by width in the filename (…-1280w.avif), so a
# new crop ships under a new name. Long cache, but not immutable: unlike
# /assets/* these names are authored by hand in scripts/build-photos.mjs rather
# than generated from a content hash, so a name could in principle be reused.
/photos/*
  Cache-Control: public, max-age=2592000

# The HTML entry points must never be cached hard. Every prerendered route file
# references the current hashed asset names, so a stale HTML document points at
# chunks that no longer exist. `must-revalidate` keeps the deploy atomic from
# the browser's point of view.
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Crawler-facing files. Short cache so a sitemap or llms.txt correction is
# picked up the same day rather than whenever a CDN edge happens to expire.
/sitemap.xml
  Cache-Control: public, max-age=3600

/llms.txt
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600
